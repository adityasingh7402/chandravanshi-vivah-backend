# Chandravanshi Vivah API — environment template (spec §79)
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# NEVER put real credentials in this file.

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Public URLs (used in health output and generated links) ----------
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- CORS allowlist: comma-separated explicit origins, no wildcards ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Request limits (spec §80) ----------------------------------------
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# --- Auth / tokens (step 04) ------------------------------------------
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_random_secret_of_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Issuer/audience are verified on every request, so a token minted for another
# system cannot be replayed here.
JWT_ISSUER=chandravanshi-vivah-api
JWT_AUDIENCE=chandravanshi-vivah-clients

# --- Sessions (step 04) ------------------------------------------------
# Entropy (bytes) of the opaque refresh token; 32 = 256 bits.
REFRESH_TOKEN_BYTES=32
# Leave empty for a host-only cookie.
COOKIE_DOMAIN=
# lax | strict | none  (none requires production/Secure)
COOKIE_SAME_SITE=lax

# --- Authentication (step 03) ------------------------------------------
PASSWORD_MIN_LENGTH=8
# Argon2id cost parameters. Defaults match the OWASP minimum (19 MiB, t=2, p=1).
ARGON2_MEMORY=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
# ISO code used when a phone is submitted without a country code.
DEFAULT_PHONE_COUNTRY=IN
# Stricter than the global limiter: brute-force protection on register/login (spec §36).
AUTH_RATE_LIMIT_WINDOW=900
AUTH_RATE_LIMIT_MAX=10

# --- Master data (step 05) ---------------------------------------------
# A search shorter than this never runs; `limit` is clamped to the maximum.
MASTER_SEARCH_MIN_LEN=2
MASTER_SEARCH_MAX_LIMIT=50
MASTER_DEFAULT_LIMIT=20
# Longest value a user may submit through the "can't find it?" path.
MASTER_MISSING_MAX_LEN=60
# Global switch for the user-contributed option path (per-category rules are code).
MASTER_MISSING_ENABLED=true

# --- Profile (step 06) -------------------------------------------------
# Configured validation bounds (spec §81); the fields dictionary calls these
# product decisions, so they live here rather than in code.
PROFILE_MIN_AGE=18
PROFILE_MAX_AGE=70
PROFILE_MIN_HEIGHT_CM=140
PROFILE_MAX_HEIGHT_CM=210
PROFILE_MAX_HOBBIES=30
PROFILE_MAX_INTERESTS=30
PROFILE_MAX_LANGUAGES=20
HEADLINE_MAX_LEN=100
ABOUT_MAX_LEN=1500

# --- Partner preferences (step 07) -------------------------------------
# The range a new preference document starts with, and the cap on every
# multi-select field. Both ages must sit inside PROFILE_MIN_AGE..PROFILE_MAX_AGE.
PREF_MIN_AGE_DEFAULT=18
PREF_MAX_AGE_DEFAULT=70
PREF_MAX_MULTI_SELECT=20

# --- Photos, Kundli documents & Cloudinary (step 08) --------------------
# Server-only secret (spec §43, §79): never put it in a client, a response or a
# log. All three values are required together, and production refuses to boot
# without them. Test/development may leave all three unset: the photo routes then
# answer 503 rather than storing an upload they cannot verify.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Development/gate stand-in for the provider, so the sign -> upload -> verify ->
# register flow can be exercised without an account. Set to true locally until
# you have real credentials — with neither set, /api/v1/photos answers 503 rather
# than storing an upload it could not verify, which also means no profile can be
# published (spec §15). Refused by config validation in production, and refused
# alongside real credentials: a shipped server must never accept an upload it
# did not actually store.
CLOUDINARY_MOCK=false
# Per-environment folder/prefix. Photo uploads land in <folder>/users/<token>
# and Kundli documents in <folder>/kundli/<token>, where <token> is a keyed
# digest of the account (never the account id, which a delivery URL would then
# publish), so an asset's owner is provable from its public id.
CLOUDINARY_UPLOAD_FOLDER=chandravanshi-vivah
# Photo caps (spec §80). The size cap is enforced from the asset's real byte
# count reported by Cloudinary, not from anything the client says.
PHOTO_MAX_COUNT=10
PHOTO_MAX_BYTES=5mb
# A subset of the formats the code is willing to serve; `svg` is not in that set
# because an uploaded SVG can carry script.
PHOTO_ALLOWED_FORMATS=jpg,jpeg,png,webp
# Signature lifetime. Cloudinary honours a signed timestamp for one hour, so this
# is capped at 3600 seconds.
PHOTO_SIGN_TTL_SECONDS=600

# --- Discover / search (step 09) ---------------------------------------
# Page sizes (spec §52, §80): `limit` defaults to the first value and is clamped
# to the second, never exceeded. DEFAULT must not exceed MAX.
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=50
# Radius cap for a distance search, in km (spec §48).
SEARCH_MAX_DISTANCE_KM=500
# Largest candidate window `recommended` scores in one request (spec §54, §55):
# bounded so a large `limit` can never turn ranking into a full-collection scan.
SEARCH_CANDIDATE_CAP=200
# Guard for the exclusion $nin strategy (spec §99). A block list larger than this
# is refused rather than silently dropping an exclusion.
EXCLUSION_MAX_IDS=1000

# --- Profile actions (step 10) -----------------------------------------
# Action writes are an abuse vector (spec §36): each (account, action type) pair
# gets its own bucket of this many writes per window.
ACTION_RATE_LIMIT_WINDOW=60
ACTION_RATE_LIMIT_MAX=60
# Page size for the caller's own action lists (shortlist, view history).
INTERACTIONS_DEFAULT_LIMIT=20
INTERACTIONS_MAX_LIMIT=100
# Minimum gap before a repeat view may refresh the target's activity signal, so
# a re-rendering client cannot cause a write storm.
VIEW_TOUCH_THROTTLE_MIN=15

# --- Interests / connections (step 11) ---------------------------------
# Cap for the optional note that accompanies an interest (spec §34, §80). It is
# plain text: "<" and ">" are refused rather than stripped.
INTEREST_MESSAGE_MAX_LEN=500
# Sending interests is an abuse vector (spec §36): this many sends per account per
# window. Accept/reject/withdraw/close share the same bucket.
INTEREST_RATE_LIMIT_WINDOW=60
INTEREST_RATE_LIMIT_MAX=30
# A pending interest that nobody answers expires after this many days (spec §21).
# No product value is published yet — see the open decision in the tracker.
INTEREST_EXPIRY_DAYS=30
# Page size for a connection list. DEFAULT must not exceed MAX.
CONNECTIONS_DEFAULT_LIMIT=20
CONNECTIONS_MAX_LIMIT=100
# Minimum gap between the lazy expiry sweeps a connection read triggers.
CONNECTIONS_SWEEP_INTERVAL_SECONDS=60

# --- Safety: blocks & reports (step 12) --------------------------------
# Cap for the optional block reason. Plain text: "<" and ">" are refused.
BLOCK_REASON_MAX_LEN=200
# Blocking is an abuse vector (spec §36): this many block writes per account per
# window. Unblock shares the same bucket.
BLOCK_RATE_LIMIT_WINDOW=60
BLOCK_RATE_LIMIT_MAX=30
# Report description and evidence caps (spec §80). Evidence items are plain
# strings — references, never arbitrary objects.
REPORT_DESCRIPTION_MAX_LEN=1000
REPORT_EVIDENCE_MAX_ITEMS=5
REPORT_EVIDENCE_MAX_LEN=500
# Filing reports is an abuse vector (spec §36): this many reports per account per
# window.
REPORT_RATE_LIMIT_WINDOW=60
REPORT_RATE_LIMIT_MAX=10

# --- Notifications (step 13) -------------------------------------------
# Inbox page size. DEFAULT must not exceed MAX.
NOTIFICATIONS_DEFAULT_LIMIT=20
NOTIFICATIONS_MAX_LIMIT=100
# Bounded growth (spec §36): a repeat profile view/shortlist from the same
# actor inside this window refreshes the existing row instead of inserting a
# new one, so a re-rendering client cannot flood an inbox.
NOTIFY_VIEW_THROTTLE_MIN=15
# Window for coalescing rapid new_message rows per conversation (step 14).
NOTIFY_MESSAGE_COALESCE_MIN=5
# Mark-read is a write (spec §36): this many mark-read calls per account per
# window, so a scripted read/unread loop cannot hammer the endpoints.
NOTIFY_RATE_LIMIT_WINDOW=60
NOTIFY_RATE_LIMIT_MAX=120

# --- Subscription / entitlement (step 15) ------------------------------
# The plan every registration receives. The current phase is indefinite free
# access (decisions §11): the grant has expiresAt=null and never expires.
DEFAULT_FREE_PLAN=free
# Declared for a FUTURE explicit payment-related update only — NOT used in this
# phase. No code path computes an expiry date from it; the free plan carries
# expiresAt=null and the sweep skips it entirely.
FREE_TRIAL_DAYS=0

# --- Admin & moderation (step 16) -------------------------------------
# Cap on the audit-entry metadata object (spec §29): an audit row carries
# small context (ids, status names, counts), never a document.
ADMIN_ACTION_MAX_METADATA_KEYS=12
# Page size for admin lists (users, reports, photos, audit logs). The default
# is what a request without `limit` gets; the maximum is a hard clamp.
ADMIN_DEFAULT_LIMIT=20
ADMIN_MAX_LIMIT=100
# Admin routes get their own limiter: they are low-volume but privileged, so a
# runaway client cannot exhaust the shared global budget (spec §36).
ADMIN_RATE_LIMIT_WINDOW=60
ADMIN_RATE_LIMIT_MAX=300

# --- Database (step 02) ------------------------------------------------
# The single most sensitive value in the app. Never commit it, never log it.
MONGODB_URI=mongodb://127.0.0.1:27017/chandravanshi_vivah
MONGODB_DB_NAME=chandravanshi_vivah
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=45000
