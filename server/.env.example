# Chandravanshi Vivah API — environment template (spec §79)
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# NEVER put real credentials in this file.

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Public URLs (used in health output and generated links) ----------
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- CORS allowlist: comma-separated explicit origins, no wildcards ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Request limits (spec §80) ----------------------------------------
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# --- Auth / tokens (step 04) ------------------------------------------
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_random_secret_of_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Issuer/audience are verified on every request, so a token minted for another
# system cannot be replayed here.
JWT_ISSUER=chandravanshi-vivah-api
JWT_AUDIENCE=chandravanshi-vivah-clients

# --- Sessions (step 04) ------------------------------------------------
# Entropy (bytes) of the opaque refresh token; 32 = 256 bits.
REFRESH_TOKEN_BYTES=32
# Leave empty for a host-only cookie.
COOKIE_DOMAIN=
# lax | strict | none  (none requires production/Secure)
COOKIE_SAME_SITE=lax

# --- Authentication (step 03) ------------------------------------------
PASSWORD_MIN_LENGTH=8
# Argon2id cost parameters. Defaults match the OWASP minimum (19 MiB, t=2, p=1).
ARGON2_MEMORY=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
# ISO code used when a phone is submitted without a country code.
DEFAULT_PHONE_COUNTRY=IN
# Stricter than the global limiter: brute-force protection on register/login (spec §36).
AUTH_RATE_LIMIT_WINDOW=900
AUTH_RATE_LIMIT_MAX=10

# --- Database (step 02) ------------------------------------------------
# The single most sensitive value in the app. Never commit it, never log it.
MONGODB_URI=mongodb://127.0.0.1:27017/chandravanshi_vivah
MONGODB_DB_NAME=chandravanshi_vivah
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=45000
